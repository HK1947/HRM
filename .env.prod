# ═══════════════════════════════════════════════════════════════════════════
# PRODUCTION ENVIRONMENT CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════
# INTERVIEW TIP: "Production tests run smoke only with strict timeouts"

ENV=prod
BASE_URL=https://opensource-demo.orangehrmlive.com
API_BASE_URL=https://opensource-demo.orangehrmlive.com/web/index.php/api/v2

# Authentication (use secrets in CI/CD, not hardcoded)
ADMIN_USERNAME=Admin
ADMIN_PASSWORD=admin123

# Test Configuration - Conservative for production
TIMEOUT=60000
RETRY_COUNT=3
WORKERS=1
HEADLESS=true

# Logging - Minimal for production
LOG_LEVEL=warn
SCREENSHOT_ON_FAILURE=true
VIDEO_ON_FAILURE=false
TRACE_ON_FAILURE=false

# Feature Flags - Only smoke tests in production
ENABLE_VISUAL_TESTS=false
ENABLE_A11Y_TESTS=false
ENABLE_PERFORMANCE_TESTS=false
