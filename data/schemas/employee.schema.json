{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "employee",
  "title": "Employee",
  "type": "object",
  "required": ["employeeId", "firstName", "lastName", "status"],
  "properties": {
    "employeeId": {
      "type": "string",
      "minLength": 1
    },
    "firstName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50
    },
    "middleName": {
      "type": "string",
      "maxLength": 50
    },
    "lastName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "status": {
      "type": "string",
      "enum": ["Active", "Inactive", "Terminated"]
    },
    "employmentType": {
      "type": "string",
      "enum": ["Full-Time", "Part-Time", "Contract", "Intern"]
    },
    "jobTitle": {
      "type": "string",
      "maxLength": 100
    },
    "department": {
      "type": "string",
      "maxLength": 100
    }
  },
  "additionalProperties": false
}
